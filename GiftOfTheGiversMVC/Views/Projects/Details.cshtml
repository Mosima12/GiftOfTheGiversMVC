@model GiftOfTheGiversMVC.Models.ReliefProject

@{
    ViewData["Title"] = Model.Name;
}

<div class="container my-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Projects</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="card shadow">
        <img src="@Model.ImageUrl" class="card-img-top"
             alt="@Model.Name" style="height: 350px; object-fit: cover;" />
        <div class="card-header text-white" style="background-color: #8B0000;">
            <h1 class="mb-0">@Model.Name</h1>
            <span class="badge bg-light text-dark">@Model.ProjectCode</span>
            <span class="badge bg-warning text-dark">@Model.Severity</span>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <h4>Description</h4>
                    <p>@Model.Description</p>

                    <h4 class="mt-4">Details</h4>
                    <table class="table">
                        <tr>
                            <td><strong>Location:</strong></td>
                            <td>@Model.Location</td>
                        </tr>
                        <tr>
                            <td><strong>Disaster Type:</strong></td>
                            <td>@Model.DisasterType</td>
                        </tr>
                        <tr>
                            <td><strong>Start Date:</strong></td>
                            <td>@Model.StartDate.ToString("dd MMMM yyyy")</td>
                        </tr>
                        <tr>
                            <td><strong>Status:</strong></td>
                            <td><span class="badge bg-success">@Model.Status</span></td>
                        </tr>
                    </table>
                </div>

                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h5>Funding</h5>
                            <h2 class="text-danger">R@(Model.AmountRaised.ToString("N0"))</h2>
                            <p class="text-muted">of R@(Model.Budget.ToString("N0"))</p>

                            <h5 class="mt-4">Volunteers</h5>
                            <h3>@Model.VolunteerCount</h3>
                            <p class="text-muted">of @Model.VolunteerTarget needed</p>

                            <a asp-controller="Donation" asp-action="Index"
                               class="btn text-white w-100 mt-3"
                               style="background-color: #8B0000;">
                                ❤️ Donate
                            </a>
                            <a asp-controller="Volunteer" asp-action="Register"
                               class="btn btn-outline-dark w-100 mt-2">
                                🤝 Volunteer
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>