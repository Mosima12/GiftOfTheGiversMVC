@{
    ViewData["Title"] = "Volunteer Registration Confirmation";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow">
                <div class="card-body py-5">
                    <h1 class="text-success">✓ Thank You!</h1>
                    <p class="lead">Your volunteer registration has been received.</p>

                    @if (TempData["Message"] != null)
                    {
                        <div class="alert alert-success mt-3">@TempData["Message"]</div>
                    }

                    <p class="mt-3">
                        We will contact you when volunteer opportunities matching
                        your skills become available.
                    </p>

                    <a href="@Url.Action("Index", "Home")"
                       class="btn text-white mt-3" style="background-color: #8B0000;">
                        Return Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>