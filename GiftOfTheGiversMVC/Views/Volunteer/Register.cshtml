@model GiftOfTheGiversMVC.Controllers.VolunteerRegistration

@{
    ViewData["Title"] = "Register as a Volunteer";
}

<div class="container my-5">
    <!-- HERO IMAGE -->
    <div class="row mb-4">
        <div class="col-12">
            <img src="~/images/volunteers/volunteers-hero.jpg" alt="Volunteers helping"
                 class="img-fluid rounded shadow"
                 style="width: 100%; max-height: 300px; object-fit: cover;" />
        </div>
    </div>

    <h1 class="text-center mb-4">Register as a Volunteer</h1>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="FullName" class="form-label">Full Name *</label>
                            <input type="text" name="FullName" id="FullName"
                                   class="form-control" required
                                   placeholder="Enter your full name" />
                        </div>

                        <div class="mb-3">
                            <label for="Email" class="form-label">Email Address *</label>
                            <input type="email" name="Email" id="Email"
                                   class="form-control" required
                                   placeholder="you@example.com" />
                        </div>

                        <div class="mb-3">
                            <label for="Phone" class="form-label">Phone Number</label>
                            <input type="tel" name="Phone" id="Phone"
                                   class="form-control"
                                   placeholder="+27 XX XXX XXXX" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Skills (Select all that apply)</label>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input type="checkbox" name="skills" value="First Aid"
                                               class="form-check-input" id="skill1" />
                                        <label class="form-check-label" for="skill1">First Aid</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input type="checkbox" name="skills" value="CPR"
                                               class="form-check-input" id="skill2" />
                                        <label class="form-check-label" for="skill2">CPR</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input type="checkbox" name="skills" value="Nursing"
                                               class="form-check-input" id="skill3" />
                                        <label class="form-check-label" for="skill3">Nursing</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input type="checkbox" name="skills" value="Logistics"
                                               class="form-check-input" id="skill4" />
                                        <label class="form-check-label" for="skill4">Logistics</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input type="checkbox" name="skills" value="Driving"
                                               class="form-check-input" id="skill5" />
                                        <label class="form-check-label" for="skill5">Driving</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input type="checkbox" name="skills" value="Translation"
                                               class="form-check-input" id="skill6" />
                                        <label class="form-check-label" for="skill6">Translation</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input type="checkbox" name="skills" value="Counselling"
                                               class="form-check-input" id="skill7" />
                                        <label class="form-check-label" for="skill7">Counselling</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input type="checkbox" name="skills" value="Warehouse"
                                               class="form-check-input" id="skill8" />
                                        <label class="form-check-label" for="skill8">Warehouse</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="Availability" class="form-label">Availability</label>
                            <textarea name="Availability" id="Availability"
                                      class="form-control" rows="3"
                                      placeholder="e.g., Weekdays after 5pm, Weekends"></textarea>
                        </div>

                        <button type="submit" class="btn btn-lg w-100 text-white"
                                style="background-color: #8B0000;">
                            Register as Volunteer
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>