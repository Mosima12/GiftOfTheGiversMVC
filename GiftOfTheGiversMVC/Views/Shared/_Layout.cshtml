<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gift of the Givers</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GiftOfTheGiversMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top shadow"
             style="background-color: #8B0000;">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Gift of the Givers"
                         height="50" class="me-2" />
                    <span class="fw-bold">Gift of the Givers</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Projects" asp-action="Index">Projects</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Donation" asp-action="Index">Donate</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Volunteer" asp-action="Register">Volunteer</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="text-white mt-5" style="background-color: #8B0000;">
        <div class="container py-5">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold mb-3">
                        <img src="~/images/logo.png" alt="Gift of the Givers"
                             height="40" class="me-2" />
                        Gift of the Givers
                    </h5>
                    <p class="small">
                        A beacon of hope in times of crisis, providing swift and effective
                        aid to communities struck by disasters in South Africa and beyond.
                    </p>
                </div>

                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold mb-3">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li>
                            <a asp-controller="Home" asp-action="Index"
                               class="text-white text-decoration-none">Home</a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="About"
                               class="text-white text-decoration-none">About Us</a>
                        </li>
                        <li>
                            <a asp-controller="Projects" asp-action="Index"
                               class="text-white text-decoration-none">Projects</a>
                        </li>
                        <li>
                            <a asp-controller="Donation" asp-action="Index"
                               class="text-white text-decoration-none">Donate</a>
                        </li>
                        <li>
                            <a asp-controller="Volunteer" asp-action="Register"
                               class="text-white text-decoration-none">Volunteer</a>
                        </li>
                    </ul>
                </div>

                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold mb-3">Contact Us</h5>
                    <address class="small mb-0">
                        <strong>Gift of the Givers Foundation</strong><br />
                        123 Relief Road<br />
                        Johannesburg, 2001<br />
                        South Africa<br />
                        <abbr title="Phone">P:</abbr> +27 11 123 4567<br />
                        <strong>Email:</strong>
                        <a href="mailto:info@giftofthegivers.org" class="text-white">
                            info@giftofthegivers.org
                        </a>
                    </address>
                </div>
            </div>

            <hr class="border-light" />

            <div class="text-center small">
                &copy; 2026 - Gift of the Givers Foundation | Making a Difference
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>