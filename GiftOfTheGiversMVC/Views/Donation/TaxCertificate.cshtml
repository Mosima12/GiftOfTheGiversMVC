@{
    ViewData["Title"] = "Tax Certificate";
}

<div class="container my-5">
    <div class="card shadow">
        <div class="card-body">
            <div class="text-center mb-4">
                <img src="~/images/logo.png" alt="Gift of the Givers" height="80" />
                <h2 class="mt-3">Gift of the Givers Foundation</h2>
                <h4 class="text-muted">Tax Certificate</h4>
            </div>

            <hr />

            <div class="row">
                <div class="col-md-6">
                    <p><strong>Certificate Number:</strong><br />@ViewBag.CertificateNumber</p>
                    <p><strong>Issue Date:</strong><br />@ViewBag.IssueDate</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Tax Year:</strong><br />@ViewBag.TaxYear</p>
                    <p><strong>Status:</strong><br />
                        <span class="badge bg-success">Valid</span>
                    </p>
                </div>
            </div>

            <hr />

            <div class="alert alert-warning">
                <strong>Note:</strong> This is a placeholder tax certificate generated for
                demonstration purposes. In the final application, this would be a downloadable PDF.
            </div>

            <div class="text-center mt-4">
                <button onclick="window.print()" class="btn text-white"
                        style="background-color: #8B0000;">
                    🖨️ Print Certificate
                </button>
                <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
                    Return Home
                </a>
            </div>
        </div>
    </div>
</div>