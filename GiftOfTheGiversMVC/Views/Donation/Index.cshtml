@{
    ViewData["Title"] = "Make a Donation";
}

<div class="container my-5">
    <h1 class="text-center mb-4">Make a Donation</h1>

    <div class="row">
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="ProcessDonation" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="amount" class="form-label">Donation Amount</label>
                            <input type="number" name="amount" id="amount"
                                   class="form-control form-control-lg"
                                   step="0.01" min="1" required
                                   placeholder="Enter amount" />
                        </div>

                        <div class="mb-3">
                            <label for="currency" class="form-label">Currency</label>
                            <select name="currency" id="currency" class="form-select">
                                <option value="ZAR">ZAR - South African Rand</option>
                                <option value="USD">USD - US Dollar</option>
                                <option value="EUR">EUR - Euro</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Donation Type</label>
                            <div class="form-check">
                                <input type="radio" name="isRecurring" value="false"
                                       class="form-check-input" id="oneTime" checked />
                                <label class="form-check-label" for="oneTime">
                                    One-Time Donation
                                </label>
                            </div>
                            <div class="form-check">
                                <input type="radio" name="isRecurring" value="true"
                                       class="form-check-input" id="recurring" />
                                <label class="form-check-label" for="recurring">
                                    Recurring Monthly Donation
                                </label>
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" name="isAnonymous" value="true"
                                   class="form-check-input" id="anonymous" />
                            <label class="form-check-label" for="anonymous">
                                Donate Anonymously
                            </label>
                        </div>

                        <button type="submit" class="btn btn-lg w-100 text-white"
                                style="background-color: #8B0000;">
                            Donate Now
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <img src="~/images/pages/donate-hero.jpg" alt="Charity donation"
                 class="img-fluid rounded shadow mb-3"
                 style="width: 100%; height: 200px; object-fit: cover;" />

            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">Why Donate?</h5>
                    <p>Your donation helps us provide emergency relief to communities affected by disasters.</p>
                    <ul>
                        <li>🚑 Emergency food parcels</li>
                        <li>💊 Medical supplies</li>
                        <li>🏠 Shelter materials</li>
                        <li>💧 Clean water</li>
                    </ul>
                    <hr />
                    <p class="text-muted mb-0">
                        <small>All donations receive a tax certificate for tax deduction purposes.</small>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>