@model List<GiftOfTheGiversMVC.Controllers.DonationRecord>

@{
    ViewData["Title"] = "My Donations";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>My Donations</h1>
        <span class="badge text-white fs-6 px-3 py-2" style="background-color: #8B0000;">
            👤 @User.Identity?.Name
        </span>
    </div>

    <hr />

    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card text-white" style="background-color: #8B0000;">
                <div class="card-body text-center">
                    <h6>Total Donated</h6>
                    <h2 class="fw-bold">R@(((decimal)ViewBag.TotalDonated).ToString("N2"))</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h6>Number of Donations</h6>
                    <h2 class="fw-bold">@ViewBag.DonationCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <h6>Tax Certificates</h6>
                    <h2 class="fw-bold">@ViewBag.DonationCount</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header text-white" style="background-color: #8B0000;">
            <h5 class="mb-0">📋 Donation History</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Type</th>
                                <th>Certificate #</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var donation in Model)
                            {
                                var formattedAmount = donation.Currency switch
                                {
                                    "ZAR" => $"R{donation.Amount:N2}",
                                    "USD" => $"${donation.Amount:N2}",
                                    "EUR" => $"€{donation.Amount:N2}",
                                    _ => $"{donation.Amount:N2} {donation.Currency}"
                                };

                                <tr>
                                    <td>@donation.Date.ToString("dd MMM yyyy")</td>
                                    <td><strong>@formattedAmount</strong></td>
                                    <td>
                                        @if (donation.IsRecurring)
                                        {
                                            <span class="badge bg-primary">Recurring</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">One-Time</span>
                                        }
                                    </td>
                                    <td><small>@donation.CertificateNumber</small></td>
                                    <td>
                                        <a asp-controller="Donation" asp-action="TaxCertificate"
                                           asp-route-certificateNumber="@donation.CertificateNumber"
                                           class="btn btn-sm btn-outline-dark">
                                            View Certificate
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h4 class="text-muted">No donations yet</h4>
                    <p class="text-muted">Your donation history will appear here.</p>
                    <a asp-controller="Donation" asp-action="Index"
                       class="btn text-white" style="background-color: #8B0000;">
                        Make Your First Donation
                    </a>
                </div>
            }
        </div>
    </div>
</div>